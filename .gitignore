# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/

# Cargo's build output. Cargo.lock is deliberately kept: this workspace ships a
# compiled artifact, so a reproducible dependency set is worth more than the
# usual library convention of ignoring it.
/rust/target/
/example/rust/target/

# The browser's core module, where `dart run re_editor:fetch_web` puts it for
# the application to serve. Fetched from a release and not carried here — the
# lock that says which release is `tool/web.lock`, and doc/web_build.md has why
# a committed copy is the alternative.
/example/web/quieditor/

# The engine is a repository of its own and is depended on over git rather than
# by path — see `quieditor_ffi` in rust/Cargo.toml. It is not tracked here:
# git records a nested repository as a single commit reference rather than as
# files, which is a submodule with none of the submodule machinery around it.
/rust/quieditor_engine/
